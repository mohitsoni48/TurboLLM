# =========================
# Stage 1: Build TurboLLM
# =========================
FROM node:22-bookworm AS build

WORKDIR /src

# Copy just the package.json/lock files first so this layer caches across source edits.
COPY turbollm/package*.json ./
COPY turbollm/web/package*.json ./web/

RUN npm ci 
RUN cd web && npm ci

# Now bring in the rest of the source and build.
COPY turbollm/ ./

# 1) React UI -> turbollm/src/webdist (web/vite.config.ts outDir)
RUN npm run build:web
# 2) Daemon -> turbollm/dist/cli.js (tsup bundle), then copies src/webdist -> dist/webdist
RUN npm run build

# Prune devDependencies (typescript/tsup/tsx/@types) — tsup externalizes
# @earendil-works/pi-ai and @earendil-works/pi-coding-agent (dynamic requires it can't
# bundle), so the *production* node_modules must still ship alongside dist/cli.js.
RUN npm prune --omit=dev

# =========================
# Stage 2: runtime
# =========================

# TurboLLM on ROCm (AMD GPUs)
FROM rocm/dev-ubuntu-22.04:6.4
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        libgomp1 && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /src/dist ./dist
COPY --from=build /src/bin ./bin
COPY --from=build /src/package.json ./package.json
COPY --from=build /src/node_modules ./node_modules

# Create models folder
RUN mkdir -p /root/.turbollm/models
# Define the model path
# lanBind is seeded true to match the 0.0.0.0 bind the container always uses (see CMD
# below), so Settings shows LAN access as on. Turning it off there re-binds the listener in
# place to 127.0.0.1 (src/cli.ts), and the published port stops answering until the next
# container start. A port change in Settings keeps 0.0.0.0, whatever lanBind says, but moves
# the listener, and the page with it, to a port this container does not publish, so that
# too stops answering until the next start, when CMD's --addr puts it back on 6996. Key
# enforcement does not depend on lanBind: src/auth.ts's isLanExposed() follows the address
# actually bound, so --addr 0.0.0.0 alone already requires the API key.
RUN echo '{ \
      "modelDirs": [ \
        "/root/.turbollm/models" \
      ], \
      "daemon": { \
        "lanBind": true, \
        "requireApiKey": true \
      } \
    }' > /root/.turbollm/config.json

# Force the GPU backend during the image build.
# Docker builds cannot detect the host GPU.
ENV TURBOLLM_SEED_BACKEND=rocm
RUN (node bin/turbollm.mjs --no-open --port 6996 &) \
    && for i in $(seq 1 60); do \
      node -e "process.exit((()=>{try{return JSON.parse(require('fs').readFileSync(process.env.HOME+'/.turbollm/config.json','utf8')).engines.length>0}catch{return false}})()?0:1)" && break; \
      sleep 3; \
    done \
    && node bin/turbollm.mjs --stop || true


EXPOSE 6996/tcp

ENTRYPOINT ["node", "bin/turbollm.mjs"]
# --addr 0.0.0.0:... required in a container (default bind is loopback-only).
# --no-open because there's no browser inside the container.
# --print-token: with the named volume above persisting ~/.turbollm (including apiKeys)
# across `restart: unless-stopped`, the automatic once-only bootstrap key only ever
# prints on the container's very first boot — miss that line in `docker logs` (or lose
# it to log rotation) and there is no way to recover it. --print-token mints and prints
# a fresh, always-findable token on EVERY start instead: `docker logs turbollm-amd | grep 'Token:'`.
CMD ["--addr", "0.0.0.0:6996", "--no-open", "--print-token"]
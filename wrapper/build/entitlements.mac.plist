<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- The first three are electron-builder's own defaults (app-builder-lib templates/entitlements.mac.plist):
         naming a file here replaces that template, so they are repeated. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- The chat's voice input. A build signed with the hardened runtime (electron-builder's default whenever it
         finds a signing identity) is refused the microphone without this, with no prompt at all. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
